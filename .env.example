# ─── Resend — Contact Form Lead Capture ───────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# Where leads are delivered (defaults to hello@stonehengetrust.com)
LEADS_TO_EMAIL=hello@stonehengetrust.com

# Sender — use a verified domain in production.
# Default falls back to onboarding@resend.dev (works without domain verification).
LEADS_FROM_EMAIL=Stonehenge Trust <leads@stonehengetrust.com>

# ─── Retell — Voice Agent ─────────────────────────────────────
# Get from https://dashboard.retellai.com
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxx
